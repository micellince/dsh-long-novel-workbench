{
  "name": "dsh-long-novel-workbench",
  "version": "0.5.2",
  "description": "长篇中文小说工作台：注意力优先（每章 0–100 分）+ 事实账本/时间线/世界地点自洽 + 章节地图 + 整本书全自动生成（含全文改动 L1/L2/L3 与去 AI 化审阅）；19 个页签、12 个 Agent 分工（含去 AI 化审稿人）、8 套名家风格预设、审稿/提案/对齐与 AI 生成。",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "micellince"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micellince/dsh-long-novel-workbench.git"
  },
  "homepage": "https://github.com/micellince/dsh-long-novel-workbench#readme",
  "bugs": {
    "url": "https://github.com/micellince/dsh-long-novel-workbench/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "novel",
    "fiction",
    "writing",
    "chinese",
    "workbench",
    "ai-writing",
    "小说",
    "写作",
    "长篇",
    "中文"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
