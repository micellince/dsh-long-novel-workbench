{
  "name": "dsh-long-novel-workbench",
  "version": "0.7.0-dev.0",
  "description": "长篇中文小说工作台（DSH 插件）0.7 开发版：编辑器原文优先、段落级意见与合并审阅、冷读=注意力、SQLite 账本本地增量同步。",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/gates.js && node --check lib/attention.js && node --check lib/aistyle.js && node --check lib/prose.js && node --check lib/store.js && node --check lib/prompts.js && node --check lib/usage.js && node --check lib/exporters.js && node --check lib/zip.js",
    "preflight": "node scripts/preflight.mjs",
    "migrate": "node scripts/migrate.js",
    "e2e": "node scripts/ui-e2e.mjs",
    "smoke": "node scripts/ui-smoke.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "author": {
    "name": "micellince"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micellince/dsh-long-novel-workbench.git"
  },
  "homepage": "https://github.com/micellince/dsh-long-novel-workbench#readme",
  "bugs": {
    "url": "https://github.com/micellince/dsh-long-novel-workbench/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "novel",
    "fiction",
    "writing",
    "chinese",
    "workbench",
    "ai-writing",
    "小说",
    "写作",
    "长篇",
    "中文"
  ]
}
